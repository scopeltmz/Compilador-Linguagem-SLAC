proc main()
locvars
   a,b,c is int;
start
   echo("Entre com três valores inteiros:");
   get(a); get(b); get(c);
   case (a+b < c | a+c < b | b+c < a)
      echo("Essas medidas não formam um triângulo.");
   otherwise
      case (a = b & b = c)
         echo("As medidas formam um triângulo equilátero");
      otherwise
         case (a ~= b & b ~= c)
            echo("As medidas formam um triângulo escaleno");
         otherwise
            echo("As medidas formam um triângulo isósceles");
         end;
      end;
   end;
end
